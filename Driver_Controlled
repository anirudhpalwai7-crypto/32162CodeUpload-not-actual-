package org.firstinspires.ftc.teamcode;


import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.eventloop.opmode.OpMode;
import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorEx;
import com.qualcomm.robotcore.hardware.IMU;
import com.qualcomm.robotcore.hardware.Servo;
import com.qualcomm.robotcore.util.Range;

@TeleOp
public class Driver_Controlled extends LinearOpMode {
    DrivetrainGO mecanum = new DrivetrainGO();

    private DcMotor Intake, Transfer;
    private DcMotorEx Turret;
    private Servo back_servo;
    int targetRPM = 2_300;
    boolean dpadUpLatch = false;
    boolean dpadDownLatch = false;

    boolean squarePressed = false;
    double Intake_RPM;
    double Transfer_RPM;
    double Turret_RPM;
    boolean slowMode = false;

    double speedExtra;

    @Override
    public void runOpMode() {

        mecanum.init(hardwareMap);
        Intake = hardwareMap.get(DcMotor.class, "Intake");
        Transfer = hardwareMap.get(DcMotor.class, "Transfer");
        Turret = hardwareMap.get(DcMotorEx.class, "Turret");
        Turret.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        Intake_RPM = Intake.getMotorType().getMaxRPM();
        Transfer_RPM = Transfer.getMotorType().getMaxRPM();
        Turret_RPM = Turret.getMotorType().getMaxRPM();
        back_servo = hardwareMap.get(Servo.class, "back_servo");
        waitForStart();
        while (opModeIsActive()) {

            double turn = -gamepad1.left_stick_y;
            double strafe = gamepad1.left_stick_x;
            double forward = gamepad1.right_stick_x;
            mecanum.drive(forward, strafe, turn);


            if (gamepad1.left_bumper) {
                slowMode = !slowMode;
            }
            {
                speedExtra = slowMode ? 0.2 : 1;

                forward *= speedExtra;
                strafe *= speedExtra;
                turn *= speedExtra;
            }

            telemetry.addData("forward speed :", forward);
            telemetry.addData("strafe speed:", strafe);
            telemetry.addData("turn speed:", strafe);


            if (gamepad2.dpad_up && !dpadUpLatch) {
                targetRPM += 100;
                dpadUpLatch = true;

            }
            if (!gamepad2.dpad_up) {
                dpadUpLatch = false;
            }

            if (gamepad2.dpad_down && !dpadDownLatch) {
                targetRPM -= 100;
                targetRPM -= 100;
                dpadDownLatch = true;
            }
            if (!gamepad2.dpad_down) {
                dpadDownLatch = false;
            }
            targetRPM = Range.clip(targetRPM, 1_600, 5_000);
            telemetry.addData("TARGET RPM:", targetRPM);
            telemetry.addData("Shooter RPM:", Turret.getVelocity() * 60.0 / 28.0);

            telemetry.addData("Intake RPM:", Intake_RPM * 0.45);
            telemetry.addData("Transfer RPM:", Transfer_RPM * 0.4);

            if (gamepad2.right_bumper) {
                Intake.setPower(-1);
            } else if (gamepad2.right_trigger > 0) {
                Intake.setPower(0.2);
            } else if (gamepad2.left_stick_y > 0) {
                Intake.setPower(0.8);
            } else {
                Intake.setPower(0);
            }
            if (gamepad2.left_bumper) {
                Transfer.setPower(-1);
            } else if (gamepad2.left_trigger > 0) {
                Transfer.setPower(1);
            } else if (gamepad2.right_stick_y > 0) {
                Transfer.setPower((0.8));
            } else {
                Transfer.setPower(0);
            }


            if (gamepad2.squareWasPressed()) {
                squarePressed = !squarePressed;
            }
            if (squarePressed) {
                Turret.setVelocity((targetRPM * 28 / 60.0));
            } else {
                Turret.setVelocity(0);
            }
            if (gamepad2.dpad_right) {
                back_servo.setPosition(0.5);

            } else {
                back_servo.setPosition(0);
            }
        }
    }
}
